# ─── Required for production ────────────────────────────────────────────
# Supabase auth credentials. Without these the site still renders, but
# sign-in is disabled and the /signin page shows a friendly notice.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Root domain used for subdomain routing and shared auth cookies.
# In local dev you can use "biobrigade.local" with /etc/hosts entries.
NEXT_PUBLIC_ROOT_DOMAIN=biobrigade.com

# ─── Optional ───────────────────────────────────────────────────────────
# Default destination after sign-in if no ?next= param is provided.
NEXT_PUBLIC_DEFAULT_APP=app

# Override the canonical site URL used in metadata and sitemap.xml. If
# unset we use https://<NEXT_PUBLIC_ROOT_DOMAIN>, falling back to Vercel's
# auto-provided VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL for previews.
# NEXT_PUBLIC_SITE_URL=https://biobrigade.com
