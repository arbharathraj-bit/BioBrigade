NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Root domain used for subdomain routing and shared auth cookies.
# In local dev you can use "biobrigade.local" with /etc/hosts entries.
NEXT_PUBLIC_ROOT_DOMAIN=biobrigade.com

# Default destination after sign-in if no ?next= param is provided.
NEXT_PUBLIC_DEFAULT_APP=app
